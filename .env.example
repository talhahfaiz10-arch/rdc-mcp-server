# Generate a long random value; never commit real secrets.
MCP_BEARER_TOKEN=replace-with-a-long-random-secret

# Public HTTPS URL or private reachable URL for the Termux bridge.
# Do not point this at an untrusted endpoint.
TERMUX_BRIDGE_URL=https://your-secure-bridge.example
TERMUX_BRIDGE_TOKEN=replace-with-the-bridge-token
BRIDGE_TIMEOUT_SECONDS=8
PORT=10000
